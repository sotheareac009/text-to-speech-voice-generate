{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Studio",
  "version": "0.3.7",
  "identifier": "com.sotheareach.voice-clone-tts",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Voice Studio",
        "width": 1080,
        "height": 880,
        "minWidth": 840,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Music",
    "shortDescription": "Khmer and multilingual product voiceovers, generated on your own machine.",
    "longDescription": "Types text, speaks it in a built-in premium voice or one cloned from a short sample, directs the read like an advert and masters it for delivery. Everything runs locally; no audio leaves the machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "resources": {
      "../python/*.py": "python/",
      "../python/requirements.txt": "python/requirements.txt"
    }
  }
}
